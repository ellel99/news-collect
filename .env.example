APP_ENV=development
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=postgresql+asyncpg://market_intelligence:local_dev_only@localhost:5432/market_intelligence
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
HEALTH_CHECK_TIMEOUT_SECONDS=2.0
COLLECTION_DISPATCH_INTERVAL_SECONDS=30
COLLECTION_STALE_RUN_SCAN_SECONDS=300
COLLECTION_STALE_RUN_AFTER_SECONDS=900
COLLECTION_ADAPTER_TIMEOUT_SECONDS=30
COLLECTION_TASK_DEADLINE_SECONDS=120
COLLECTION_BATCH_LIMIT=100
COLLECTION_MAX_RETRIES=3
COLLECTION_RETRY_BASE_SECONDS=5
COLLECTION_RETRY_MAX_SECONDS=300
COLLECTION_MAX_RETRY_AFTER_SECONDS=900
COLLECTION_LOCK_TTL_SECONDS=180
MULTI_PROVIDER_SCHEDULER_EXECUTE=false
MULTI_PROVIDER_SCHEDULER_TICK_SECONDS=60
MARKETAUX_CADENCE_SECONDS=300
FINNHUB_CADENCE_SECONDS=900
EIA_CADENCE_SECONDS=21600
SEC_EDGAR_CADENCE_SECONDS=1800

# Provider preflight only. Keep real values in an untracked local .env.
# Required for bounded smoke
MARKETAUX_API_TOKEN=
FINNHUB_API_KEY=
EIA_API_KEY=
EIA_API_VERSION=v2
SEC_USER_AGENT=
SEC_CONTACT_EMAIL=

# Optional contract review metadata
# These do not block a minimal bounded smoke. Missing values block contract
# approval, Adapter implementation, and production collection.
MARKETAUX_PLAN=
MARKETAUX_DAILY_LIMIT=
MARKETAUX_ALLOWED_RETENTION=
MARKETAUX_INTERNAL_AI_ALLOWED=
FINNHUB_PLAN=
FINNHUB_RATE_LIMIT=
FINNHUB_ALLOWED_RETENTION=

# Future / blocked NewsAPI.ai
# Retained as placeholders only. CLI --execute fails closed for this provider.
NEWSAPI_AI_API_KEY=
NEWSAPI_AI_PLAN=
NEWSAPI_AI_QUOTA=
NEWSAPI_AI_ALLOWED_RETENTION=
NEWSAPI_AI_INTERNAL_AI_ALLOWED=
